APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Escuta em todas as interfaces para o container do Evolution Go alcançar o app (host.docker.internal)
SERVER_HOST=0.0.0.0

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_TEST_DATABASE=laravel_test

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution-local-key
EVOLUTION_PORT=8080
EVOLUTION_TEST_ALLOWED_PHONES=
# URL que o container do Evolution Go usa para chamar o app (localhost aponta para o próprio container)
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/whatsapp-test

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use reverb in production and keep this process running beside the queue workers.
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
# Original knowledge-base files use this configurable private disk.
KNOWLEDGE_FILES_DISK=local
# PDF extraction requires the poppler-utils package (pdftotext) in CI and workers.
# KNOWLEDGE_PDFTOTEXT_BINARY=/usr/bin/pdftotext
QUEUE_CONNECTION=redis

FLOW_HUMAN_RETURN_AFTER_SECONDS=86400
FLOW_HUMAN_ASSIGNMENT_IDLE_SECONDS=900

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=150

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

HORIZON_REDIS_CONNECTION=default
HORIZON_PATH=horizon

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
